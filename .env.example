# Wazuh on the Pop!_OS lab host (LAN).
# On Pop itself, autonomy uses 127.0.0.1 for API/indexer (already in Pop .env — do not overwrite).
WAZUH_API_URL=https://<SIEM_HOST>:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=<wazuh-api-password>
WAZUH_API_VERIFY_SSL=false

WAZUH_INDEXER_URL=https://<SIEM_HOST>:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=<indexer-password>
WAZUH_INDEXER_VERIFY_SSL=false

# Browser link shown in the analyst dashboard (not an API endpoint)
WAZUH_DASHBOARD_URL=https://<SIEM_HOST>

# Local case store. Mac default is this repo's file.
# Pop autonomy + dashboard use $AGENTIC_SOC_HOME/data/cases.sqlite (separate copy).
CASES_DB_PATH=data/cases.sqlite

# Optional enrichment (leave blank until needed)
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# Discord incoming webhook — fallback when the Gateway bot env is unset.
# Never commit the real URL.
DISCORD_WEBHOOK_URL=

# Discord Gateway bot (preferred for case-opened outcome buttons).
# Outbound websocket only — no Interactions HTTP URL / no new inbound port.
# Create Application → Bot in Discord Developer Portal; invite with
# Send Messages + Use Application Commands. Never commit the real token.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# Optional allowlist (snowflake). Empty = any guild the bot is in.
DISCORD_GUILD_ID=

# --- Pop autonomy knobs (also set in deploy/agentic-soc-autonomy.service) ---
# AUTONOMY_INTERVAL=120
# AUTONOMY_MIN_LEVEL=8
# AUTONOMY_LIMIT=40
# AUTONOMY_MAX_CASES=10
# Unset watches every agent and non-agent source. Set a name to limit the poll.
# AUTONOMY_AGENT_NAME=
# AUTONOMY_EXCLUDE_UFW_BLOCKS=true
# Auth L5 is OR'd into the indexer query; do not lower AUTONOMY_MIN_LEVEL to 5.
# AUTONOMY_INCLUDE_AUTH=true
# AUTONOMY_AUTH_MIN_LEVEL=5
# Skip repeats after a human reject of the same rule_id + source IP (14 days).
# AUTONOMY_FEEDBACK_SKIP=true
# Auto-close informational/FP without Discord/Cursor. Suspicious stays HITL. No containment.
# AUTONOMY_AUTO_CLOSE_NOISE=true
# AUTONOMY_ENRICH=true
# AUTONOMY_DISCORD=true
# AUTONOMY_LOG_LEVEL=INFO

# HITL UFW deny (Phase E). Default off. Autonomy never executes this.
# CONTAINMENT_ENABLED=false
# CONTAINMENT_PROTECT_IPS=<SIEM_HOST>,127.0.0.1

# HITL host isolation via Wazuh Active Response (Phase F). Default off.
# Separate from CONTAINMENT_ENABLED. Autonomy never executes this.
# Install scripts from deploy/wazuh/active-response/ before turning this on.
# HOST_ISOLATION_ENABLED=false
# ISOLATION_PROTECT_AGENTS=pop-os-native
# WAZUH_AR_ISOLATE_CMD=network-isolation0
# WAZUH_AR_DEISOLATE_CMD=network-deisolation0
# WAZUH_AR_ISOLATE_CMD_WIN=network-isolation-win0
# WAZUH_AR_DEISOLATE_CMD_WIN=network-deisolation-win0
# Copied into each agent's isolation.conf (not read by this app at runtime).
# ISOLATION_ALLOWED_SSH_IPS=<ANALYST_IP>

# --- Cursor cloud investigation (already enabled on Pop; do not use Hydra) ---
# Optional extra: pip install -e '.[cursor]' on Pop when enabling this path.
# AUTONOMY_CURSOR_AGENT=true
# CURSOR_API_KEY=          # from https://cursor.com/dashboard/integrations — never commit
# CURSOR_AGENT_MODEL=composer-2.5
# CURSOR_AGENT_REPO=https://github.com/<your-org>/Agentic_SOC
# CURSOR_AGENT_NOREPO_FALLBACK=true
# CURSOR_AGENT_STARTING_REF=main
# Optional: force dashboard banner (pop-live | mac-local). Auto-detects from CASES_DB_PATH.
# AGENTIC_SOC_INSTANCE=
# Optional extra: URL the *cloud VM* can PATCH (not required — Pop copies the final reply locally)
# AGENTIC_SOC_API_URL=http://127.0.0.1:8080
# Optional self-hosted pool name (LAN-capable worker); leave empty for public Cursor cloud:
# CURSOR_CLOUD_POOL=
