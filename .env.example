# Wazuh on the Pop!_OS lab host (LAN)
WAZUH_API_URL=https://192.168.50.254:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=MyS3cr37P450r.*-
WAZUH_API_VERIFY_SSL=false

WAZUH_INDEXER_URL=https://192.168.50.254:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=SecretPassword
WAZUH_INDEXER_VERIFY_SSL=false

# Browser link shown in the analyst dashboard (not an API endpoint)
WAZUH_DASHBOARD_URL=https://192.168.50.254

# Local case store (Mac default). Laptop autonomy uses its own copy unless synced.
CASES_DB_PATH=data/cases.sqlite

# Optional enrichment (leave blank until needed)
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# Discord incoming webhook (channel → Integrations → Webhooks)
# Never commit the real URL.
DISCORD_WEBHOOK_URL=

# --- Optional: Cursor cloud investigation (Mac-offline / Pop autonomy) ---
# Install on Pop: pip install -e '.[cursor]'
# Docs: SETUP_GUIDE.md §13
# AUTONOMY_CURSOR_AGENT=false
# CURSOR_API_KEY=          # from https://cursor.com/dashboard/integrations — never commit
# CURSOR_AGENT_MODEL=composer-2.5
# CURSOR_AGENT_REPO=https://github.com/YOUR_ORG/Agentic_SOC
# CURSOR_AGENT_STARTING_REF=main
# Optional write-back URL for the cloud agent (tunnel or self-hosted pool on Pop):
# AGENTIC_SOC_API_URL=http://127.0.0.1:8080
# Optional self-hosted pool name (LAN-capable worker); leave empty for public Cursor cloud:
# CURSOR_CLOUD_POOL=

