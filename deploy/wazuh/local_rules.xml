<group name="local,firewall,">
  <rule id="100100" level="5">
    <if_sid>5100</if_sid>
    <match>[UFW BLOCK]</match>
    <description>UFW firewall block event.</description>
    <group>firewall_drop,ufw,pci_dss_1.4,</group>
  </rule>
  <rule id="100101" level="10" frequency="12" timeframe="60" ignore="120">
    <if_matched_sid>100100</if_matched_sid>
    <same_source_ip />
    <description>Possible port scan: multiple UFW blocks from same source.</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>multiple_drops,portscan,recon,attack,pci_dss_1.4,</group>
  </rule>
  <rule id="100102" level="8" frequency="6" timeframe="30" ignore="60">
    <if_matched_sid>100100</if_matched_sid>
    <same_source_ip />
    <description>Possible port scan (lab): repeated UFW blocks from same source.</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>multiple_drops,portscan,recon,attack,</group>
  </rule>
</group>

<group name="asus,syslog,">
  <rule id="100200" level="3">
    <program_name>HTTPD|BWDPI|rc_service</program_name>
    <description>ASUS RT-AX3000 syslog.</description>
    <group>asus,router,</group>
  </rule>
  <rule id="100201" level="3">
    <if_sid>30100</if_sid>
    <match>[LOGIN]</match>
    <description>ASUS web admin login success.</description>
    <group>asus,authentication_success,</group>
  </rule>
  <rule id="100202" level="7">
    <if_sid>30100</if_sid>
    <match>[LOGIN]</match>
    <regex type="pcre2">(fail|failed|incorrect|invalid|denied)</regex>
    <description>ASUS web admin login failure.</description>
    <group>asus,authentication_failed,</group>
  </rule>
  <rule id="100203" level="3">
    <if_sid>4100</if_sid>
    <match>DROP IN=</match>
    <description>ASUS kernel DROP (often IGMP/multicast lab noise).</description>
    <group>asus,firewall_drop,</group>
  </rule>
</group>

<group name="local,privilege_escalation,">
  <rule id="100300" level="10">
    <if_sid>5405</if_sid>
    <description>Privilege escalation attempt: user not in sudoers.</description>
    <mitre>
      <id>T1548.003</id>
    </mitre>
    <group>authentication_failed,privilege_escalation,attack,</group>
  </rule>
</group>

<group name="local,windows,active_directory,">
  <rule id="100400" level="12">
    <if_sid>60106</if_sid>
    <field name="win.system.eventID">^4769$</field>
    <field name="win.eventdata.ticketEncryptionType">^0x17$</field>
    <field name="win.eventdata.serviceName" negate="yes">\$$</field>
    <description>Possible Kerberoast: RC4 service ticket for a user account.</description>
    <mitre>
      <id>T1558.003</id>
    </mitre>
    <group>windows,windows_security,attack,kerberos,</group>
  </rule>
  <rule id="100401" level="12">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4768$</field>
    <field name="win.eventdata.preAuthType">^0$</field>
    <description>Possible AS-REP roast: Kerberos TGT without pre-authentication.</description>
    <mitre>
      <id>T1558.004</id>
    </mitre>
    <group>windows,windows_security,attack,kerberos,</group>
  </rule>
  <rule id="100410" level="12">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4662$</field>
    <match>1131f6aa-9c07-11d1-f79f-00c04fc2dcd2|1131f6ad-9c07-11d1-f79f-00c04fc2dcd2|89e95b76-444d-4c62-991a-0facbeda640c</match>
    <description>Possible DCSync: directory replication rights used.</description>
    <mitre>
      <id>T1003.006</id>
    </mitre>
    <group>windows,windows_security,attack,credential_access,</group>
  </rule>
  <rule id="100420" level="10">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4886$|^4887$</field>
    <description>Active Directory certificate requested or issued.</description>
    <mitre>
      <id>T1649</id>
    </mitre>
    <group>windows,windows_security,attack,</group>
  </rule>
  <rule id="100421" level="8">
    <if_sid>60121</if_sid>
    <description>Computer account added or changed in Active Directory.</description>
    <mitre>
      <id>T1136.002</id>
    </mitre>
    <group>windows,windows_security,attack,</group>
  </rule>
  <rule id="100430" level="10">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^5136$</field>
    <match>msDS-AllowedToActOnBehalfOfOtherIdentity</match>
    <description>Resource-based constrained delegation attribute changed.</description>
    <mitre>
      <id>T1222</id>
    </mitre>
    <group>windows,windows_security,attack,</group>
  </rule>
</group>
