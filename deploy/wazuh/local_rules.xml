<group name="local,firewall,">
  <rule id="100100" level="5">
    <if_sid>5100</if_sid>
    <match>[UFW BLOCK]</match>
    <description>UFW firewall block event.</description>
    <group>firewall_drop,ufw,pci_dss_1.4,</group>
  </rule>
  <rule id="100101" level="10" frequency="12" timeframe="60" ignore="120">
    <if_matched_sid>100100</if_matched_sid>
    <same_source_ip />
    <description>Possible port scan: multiple UFW blocks from same source.</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>multiple_drops,portscan,recon,attack,pci_dss_1.4,</group>
  </rule>
  <rule id="100102" level="8" frequency="6" timeframe="30" ignore="60">
    <if_matched_sid>100100</if_matched_sid>
    <same_source_ip />
    <description>Possible port scan (lab): repeated UFW blocks from same source.</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>multiple_drops,portscan,recon,attack,</group>
  </rule>
</group>

<group name="asus,syslog,">
  <rule id="100200" level="3">
    <program_name>HTTPD|BWDPI|rc_service</program_name>
    <description>ASUS RT-AX3000 syslog.</description>
    <group>asus,router,</group>
  </rule>
  <rule id="100201" level="3">
    <if_sid>30100</if_sid>
    <match>[LOGIN]</match>
    <description>ASUS web admin login success.</description>
    <group>asus,authentication_success,</group>
  </rule>
  <rule id="100202" level="7">
    <if_sid>30100</if_sid>
    <match>[LOGIN]</match>
    <regex type="pcre2">(fail|failed|incorrect|invalid|denied)</regex>
    <description>ASUS web admin login failure.</description>
    <group>asus,authentication_failed,</group>
  </rule>
  <rule id="100203" level="3">
    <if_sid>4100</if_sid>
    <match>DROP IN=</match>
    <description>ASUS kernel DROP (often IGMP/multicast lab noise).</description>
    <group>asus,firewall_drop,</group>
  </rule>
</group>
