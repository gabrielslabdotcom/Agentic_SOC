<!-- Insert before the existing secure <remote> block in wazuh_manager.conf.
     allowed-ips is required. Pin your syslog source (documentation example below).
     Do not set <local_ip> to the SIEM host address inside Docker. -->
<remote>
  <connection>syslog</connection>
  <port>514</port>
  <protocol>udp</protocol>
  <allowed-ips>203.0.113.0/24</allowed-ips>
</remote>
