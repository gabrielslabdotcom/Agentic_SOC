[Unit]
Description=Agentic SOC autonomous triage loop
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/admin/Agentic_SOC
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/admin/Agentic_SOC/.env
Environment=AUTONOMY_INTERVAL=120
Environment=AUTONOMY_MIN_LEVEL=8
Environment=AUTONOMY_LIMIT=40
Environment=AUTONOMY_MAX_CASES=10
Environment=AUTONOMY_AGENT_NAME=pop-os-native
Environment=AUTONOMY_ENRICH=true
Environment=AUTONOMY_DISCORD=true
Environment=AUTONOMY_EXCLUDE_UFW_BLOCKS=true
# Cursor cloud propose-only investigation (Mac-offline). Keep false until
# CURSOR_API_KEY + CURSOR_AGENT_REPO are set in .env and `[cursor]` extra is installed.
# Environment=AUTONOMY_CURSOR_AGENT=false
# Environment=CURSOR_AGENT_MODEL=composer-2.5
# Do not put CURSOR_API_KEY here — use EnvironmentFile .env only.
ExecStart=/home/admin/Agentic_SOC/.venv/bin/python /home/admin/Agentic_SOC/scripts/autonomy_loop.py
Restart=on-failure
RestartSec=15
Nice=10
# Allow the current alert (indexer ~30s + VT) to finish on SIGTERM.
# autonomy_loop checks the stop flag between alerts. SIGKILL remains fallback.
TimeoutStopSec=90
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=default.target
