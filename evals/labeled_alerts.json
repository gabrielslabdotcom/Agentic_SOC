        "id": "tp-port-scan-multi",
        "rule_id": "100101",
        "rule_level": 10,
        "description": "Possible port scan: multiple UFW blocks from same source.",
        "agent": "lab-agent",
        "timestamp": "2026-09-15T12:00:00.000Z",
        "full_log": "UFW BLOCK SRC=198.51.100.20 DST=10.0.0.5",
        "raw": {
          "rule": {
            "id": "100101",
            "level": 10,
            "description": "Possible port scan: multiple UFW blocks from same source.",
            "groups": [
              "firewall",
              "ufw",
              "attack"
            ]
          },
          "full_log": "UFW BLOCK SRC=198.51.100.20 DST=10.0.0.5",
          "agent": {
            "name": "lab-agent"
          }
        }
      },
      "expected": {
        "disposition": "true_positive",
        "open_case": true
      }
    },
